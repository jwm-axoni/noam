{
  "version": 1,
  "ignoredDirectories": [
    ".git",
    ".lavish",
    ".turbo",
    "dist",
    "gen",
    "node_modules",
    "target"
  ],
  "legalOnlyTokenHashes": [
    {
      "id": "third-party-project-name",
      "sha256": "c5a95c14cb30e8ad8dc98a185b39bcb2a803c9a4f4a7b9a3d6201ec41b30928c",
      "allowedPaths": ["NOTICE"]
    }
  ],
  "blockedTokenHashes": [],
  "regexRules": [
    {
      "id": "personal-email-provider",
      "severity": "blocker",
      "pattern": "[A-Z0-9._%+-]+@(gmail|icloud|outlook|hotmail|yahoo|protonmail|proton)\\.[A-Z]{2,}",
      "flags": "i",
      "allowedPaths": ["scripts/check-publication.test.mjs"]
    },
    {
      "id": "macos-home-path",
      "severity": "blocker",
      "pattern": "/Users/(?!x(?:/|$)|user(?:/|$)|<me>(?:/|$))[^/\\s]+",
      "flags": "i",
      "allowedPaths": [".publication-policy.json"]
    },
    {
      "id": "linux-home-path",
      "severity": "blocker",
      "pattern": "/home/(?!me(?:/|$)|user(?:/|$)|<me>(?:/|$))[^/\\s]+",
      "flags": "i",
      "allowedPaths": [".publication-policy.json"]
    },
    {
      "id": "windows-home-path",
      "severity": "blocker",
      "pattern": "[A-Z]:\\\\Users\\\\(?!x(?:\\\\|$)|user(?:\\\\|$)|<me>(?:\\\\|$))[^\\\\\\s]+",
      "flags": "i",
      "allowedPaths": [".publication-policy.json"]
    },
    {
      "id": "private-key",
      "severity": "blocker",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "flags": "i"
    },
    {
      "id": "github-token",
      "severity": "blocker",
      "pattern": "gh[pousr]_[A-Z0-9]{20,}",
      "flags": "i"
    },
    {
      "id": "openai-key",
      "severity": "blocker",
      "pattern": "sk-[A-Z0-9_-]{20,}",
      "flags": "i"
    },
    {
      "id": "aws-access-key",
      "severity": "blocker",
      "pattern": "AKIA[0-9A-Z]{16}",
      "flags": ""
    },
    {
      "id": "git-remote-review",
      "severity": "review",
      "pattern": "\\S+",
      "flags": "",
      "scopes": ["remote"]
    }
  ]
}
