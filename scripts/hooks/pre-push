#!/usr/bin/env bash
#
# Pre-push guard: refuse to push if the publication check finds blockers
# (personal data, home paths, and the patterns in .publication-policy.json).
# A layer of defense that runs on your machine, before anything reaches
# GitHub — so it works even when CI can't.
#
# Activate in a clone with:   git config core.hooksPath scripts/hooks
# Emergency bypass (rare):    git push --no-verify
#
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found, skipping publication check" >&2
  exit 0
fi
echo "pre-push: running publication check..."
if ! node "$root/scripts/check-publication.mjs" --scope tree; then
  echo "" >&2
  echo "pre-push: BLOCKED — the publication check found blockers above." >&2
  echo "          Fix them before pushing (or, in a real emergency, git push --no-verify)." >&2
  exit 1
fi
echo "pre-push: publication check clean."
